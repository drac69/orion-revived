  <id>app.orion.orion</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Orion</name>
  <summary>Native Twitch desktop client</summary>
  <developer id="app.orion">
    <name>Orion contributors</name>
  </developer>
  <launchable type="desktop-id">Orion.desktop</launchable>
  <description>
    <p>
      Orion is a Qt desktop client for Twitch. It can browse live channels
      and games, play live streams and VODs, show Twitch chat, send desktop
      notifications, and save local preferences for playback and chat.
    </p>
  </description>
